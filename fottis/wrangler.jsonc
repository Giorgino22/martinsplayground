// Cloudflare Workers config for Humm (fottis.odermatts.ch).
// "name" must be exactly the Worker's name in the Cloudflare dashboard.
{
  "name": "humm",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // Keeps logs (console.log in identify.js) under the Worker's "Logs" tab.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Send /api/* to worker.js before looking for a file.
    "run_worker_first": ["/api/*"]
  }
}
